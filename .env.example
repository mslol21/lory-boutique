# Prefer npm run setup: generates a private JWT_SECRET and an administrator.
# Node.js 22.16+; recommended Node.js 24 LTS.
JWT_SECRET=
PORT=3001
# Optional absolute path on a persistent local disk:
# DB_PATH=/var/lib/lory/loryboutique.db
# Only set these to provision the initial admin; no default password exists:
# ADMIN_USERNAME=admin
# ADMIN_NAME=Administrador Lory
# ADMIN_PASSWORD=
# For a separate frontend origin only:
# CORS_ORIGIN=https://your-frontend.example

# Online: Neon > Connect > PostgreSQL connection string (prefer pooled for Vercel).
# Use sslmode=require in connection string. NEVER prefix DATABASE_URL with VITE_.
# Switch production only after migrating and validating users, products, sales and cash data.
DATABASE_URL=
# Optional custom TLS CA for private/legacy PostgreSQL connections.
# Neon normally works with system trusted CAs; DATABASE_CA_CERT is not needed.
DATABASE_CA_CERT=
